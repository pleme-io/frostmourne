;; frostmourne :: latency-budget
;; ─────────────────────────────
;; Measures what a shell spawn actually costs and fails when it regresses
;; past a declared ceiling.
;;
;; ── Why this exists as a committed tool and not as a benchmark I ran once
;;
;; Every number in the 2026-08-07 shell-latency work was produced by ad-hoc
;; `hyperfine` invocations and throwaway python/bash harnesses — 41 scratch
;; files in one session. That approach produced a WRONG ANSWER three separate
;; times, each caught only by chance:
;;
;;   1. the harness sent LF where a terminal sends CR, so reedline's
;;      paste-batching path waited its full 100 ms POLL_WAIT and every
;;      per-command figure was inflated by ~100 ms;
;;   2. "read until quiet" stopped the clock on the tty ECHO rather than on
;;      the prompt, reporting ~0 ms for work that took 250 ms;
;;   3. a `direnv` benchmark inherited warm DIRENV_* state from the invoking
;;      shell, so both arms measured the warm path and the fix looked like a
;;      null result.
;;
;; A measurement whose failure mode looks like a measurement cannot verify
;; anything. So the budget lives here, in one file, with the ceilings written
;; down and the environment explicitly controlled.
;;
;; ── What it does NOT do, stated so nobody reads more into a green run
;;
;; This measures SPAWN cost only — `frostmourne -c exit`, which is the one
;; number obtainable without a pty. The interactive figures that matter most
;; to a human (time-to-first-prompt, Enter→prompt, cd) need a pty harness that
;; answers frost's boot-time DSR cursor query, and that is genuinely not
;; expressible here: tatara-script's process family is exec/capture, with no
;; pty(2) or select(2). Those belong in a Rust dojo facet (theory/DOJO.md's
;; `(defperf-lever)`), and until that ships the interactive budget is
;; UNMEASURED rather than green.
;;
;; TIER: only-mitigated. This is a wall-clock threshold checked by a script
;; somebody has to run — not a type, not a gate. It catches a regression that
;; crosses the ceiling on the machine it runs on; it proves nothing about any
;; other machine, and a 2x slowdown that stays under the ceiling passes.
;; Wall-clock is a world-fact, so this is the honest ceiling for the shape,
;; but do not read a green run as "the shell is fast".
;;
;; Usage:
;;   tatara-script tools/latency-budget.tlisp [shell-path]
;;   tatara-script --test tools/latency-budget.tlisp

;; ── The declared budget ────────────────────────────────────────────────
;;
;; Measured on ryn (M-series darwin, 2026-08-07) after the day's fixes:
;; frostmourne -c exit ≈ 51 ms with a compiled wrapper and the full 1358-form
;; rc. The ceiling is set at 90 ms — comfortably above the measured value but
;; far below the 134 ms this started at, so the specific regressions that were
;; fixed cannot silently return. It is deliberately NOT set just above the
;; current number: a ceiling that tight fails on a loaded machine and gets
;; disabled, which is worse than a loose ceiling that holds.
(define budget-ms 90)

;; Runs per arm. Enough to see past scheduler noise on a loaded box without
;; making the check something people skip because it takes too long.
(define runs 12)

;; ── One timed spawn, in nanoseconds ────────────────────────────────────
;;
;; now-ns is monotonic, so this is immune to wall-clock adjustment mid-run.
;; The child's status is checked: a shell that FAILS fast would otherwise
;; measure as a wonderful improvement, which is the classic benchmark lie.
(define (timed-spawn shell)
  (let* ((t0 (now-ns))
         (r (exec-capture shell "-c" "exit"))
         (ns (elapsed-since t0))
         (status (alist-get r :status)))
    (if (= status 0)
        ns
        (begin
          (log-error (string-format "spawn FAILED (status {}) — a failing shell is not a fast shell" status))
          -1))))

;; ── Median rather than mean ────────────────────────────────────────────
;;
;; A single scheduler hiccup moves a mean and does not move a median, and on
;; this machine load average swung between 4 and 49 during one afternoon.
;; `sort-by` takes a COMPARATOR returning an integer (negative / zero /
;; positive), not a key function — verified by running it: a boolean
;; comparator silently sorts DESCENDING rather than erroring, which is
;; exactly the quiet-wrong-answer shape this file exists to avoid.
(define (median xs)
  (let* ((s (sort-by (fn (a b) (- a b)) xs))
         (n (count s)))
    (nth (/ n 2) s)))

(define (measure shell)
  (median (map (fn (_) (timed-spawn shell)) (range 0 runs))))

;; ── Main ───────────────────────────────────────────────────────────────
;;
;; ★ INVOKED AT TOP LEVEL, DELIBERATELY. tatara-script runs a file's top-level
;; forms and does NOT auto-call a function named `main`. The first cut of this
;; file defined `main` and never called it: the tool printed nothing, measured
;; nothing, and **exited 0**. It would have been committed as a passing check
;; that could never fail — the precise vacuous-gate shape this file's header
;; warns about, reproduced by its own author within the hour.
(define (run-budget shell)
  (let* ((ns (measure shell))
         (ms (/ ns 1000000)))
    (println (string-format "frostmourne spawn: {} ms (median of {}), budget {} ms" ms runs budget-ms))
    (if (< ns 0)
        (begin (log-error "measurement invalid — see above") 1)
        (if (> ms budget-ms)
            (begin
              (log-error (string-format "OVER BUDGET: {} ms > {} ms" ms budget-ms))
              (log-error "Known contributors, each with a receipt in git log:")
              (log-error "  a bash wrapper on the launcher      ~9 ms")
              (log-error "  re-parsing the rc once per form    ~24 ms")
              (log-error "  enumerating $PATH on every run()   ~17 ms")
              1)
            (begin (println "within budget") 0)))))

;; The actual invocation. `argv-get` returns nil past the end, so a bare run
;; measures whatever `frostmourne` resolves to on PATH; pass a store path to
;; measure a specific build.
(exit (run-budget (or (argv-get 0) "frostmourne")))

(deftest budget-is-declared-not-derived
  ;; The ceiling must be a literal an operator can read and argue with, not
  ;; something computed from a previous run — a self-adjusting budget ratchets
  ;; upward forever and never fails.
  (assert (> budget-ms 0) "budget must be positive")
  (assert (< budget-ms 1000) "a budget over a second is not a budget"))

(deftest median-picks-the-middle-not-the-mean
  ;; Guards the property the comment above claims: one huge outlier must not
  ;; move the result. The mean of these is 2501; the median is 3.
  (assert (equal? 3 (median (list 1 3 2 10000))) "median must ignore the outlier"))
