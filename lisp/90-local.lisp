;; frostmourne :: 90-local
;; ───────────────────────
;; Per-machine private overlay. Loaded LAST (after every curated default)
;; so the operator's own forms win on collision. OPTIONAL — a host that
;; has no local.lisp loads the rest of the rc unaffected (frost's
;; `defsource :optional` skips a missing file instead of erroring).
;;
;; This is where USER-SPECIFIC / private config lives — things that must
;; never ship in the public distribution:
;;   * ssh-host aliases (per-host users, internal hostnames, tailnet)
;;   * machine-local tool shortcuts / secrets-adjacent profiles
;;   * any path or identity that is this operator's, not everyone's.
;;
;; The file is GENERATED by the nix/home-manager layer from the fleet
;; registry (see `programs.frostmourne.localLisp` in module/default.nix,
;; wired in the private `nix` repo from `lib/pleme-fleet.nix`) — never
;; hand-authored into this public tree. Drop one by hand for ad-hoc use:
;;
;;   ~/.config/frostmourne/local.lisp
;;     (defalias :name "ssh-box" :value "ssh me@box.internal")
(defsource :path "${XDG_CONFIG_HOME:-$HOME/.config}/frostmourne/local.lisp" :optional #t)
